#!/bin/bash
# cast-tab — play the video from the front browser's active tab (or a URL) on the TV: Google Cast (Samsung TV) or
# AirPlay (Apple TV, when CAST_ATV is set).
# Usage: cast-tab            video in the front tab → TV, starting where the page is; page video pauses
#        cast-tab <url>      cast any URL (yt-dlp sites: YouTube, Vimeo, …)
#        cast-tab clip       cast the URL in the clipboard
#        cast-tab back       stop the TV and continue in the page from the TV position
#        cast-tab toggle | play | pause | stop | status | info | skip
#        cast-tab rewind [s] | ffwd [s] | seek <s> | volume <0-100> | volumeup [d] | volumedown [d] | volumemute
#        cast-tab pair       pair with the Apple TV (once; PIN shown on the TV)
#        cast-tab use [airplay|cast|toggle]   which TV, when both are configured (default: AirPlay); no arg: show it
#
# How a tab is cast: 1) yt-dlp (via catt) for sites it knows; 2) otherwise the stream the page's player loaded is read
# from the tab (tab-media) and cast directly, with the subtitle track if one was loaded. Page-player sites listed in
# PAGE_PLAYER_SITES skip step 1. Only the video plays on the TV — Mac screen untouched, full quality.

CONFIG="$HOME/.config/cast-tab/config"; [ -f "$CONFIG" ] && . "$CONFIG"   # CAST_TV=<ip or name> (from: catt scan)
set_conf() {   # KEY VALUE: change that line of the config, keep the others
  if grep -q "^$1=" "$CONFIG" 2>/dev/null; then sed -i '' "s|^$1=.*|$1=$2|" "$CONFIG"
  else mkdir -p "$(dirname "$CONFIG")"; echo "$1=$2" >> "$CONFIG"; fi
}

# CAST_ATV=<Apple TV ip> (from: atvremote scan) → AirPlay. With both configured, CAST_USE picks: airplay (default) or cast
if [ "$1" = use ]; then
  CUR=airplay; { [ -z "${CAST_ATV:-}" ] || [ "${CAST_USE:-}" = cast ]; } && CUR=cast
  case "${2:-}" in
    "")                           NEW=$CUR ;;
    toggle)                       [ "$CUR" = airplay ] && NEW=cast || NEW=airplay ;;
    airplay|apple|appletv|atv)    NEW=airplay ;;
    cast|chromecast|google)       NEW=cast ;;
    *) echo "usage: cast-tab use [airplay|cast|toggle]"; exit 2 ;;
  esac
  [ "$NEW" = airplay ] && [ -z "${CAST_ATV:-}" ] && { echo "No Apple TV configured — put CAST_ATV=<ip> in $CONFIG"; exit 1; }
  [ "$NEW" = cast ] && [ -z "${CAST_TV:-}" ] && { echo "No Cast TV configured — put CAST_TV=<ip> in $CONFIG"; exit 1; }
  [ -n "${2:-}" ] && set_conf CAST_USE "$NEW"
  [ "$NEW" = airplay ] && echo "📺 AirPlay (Apple TV)" || echo "📺 Chromecast (Google Cast TV)"
  exit 0
fi

TV="${CAST_TV:-}"; ATV="${CAST_ATV:-}"
[ "${CAST_USE:-}" = cast ] && [ -n "$TV" ] && ATV=""   # AirPlay unless switched to Cast
[ -z "$TV$ATV" ] && { echo "No TV configured — put CAST_TV=<ip> in $CONFIG (find it with: catt scan)"; exit 1; }
CATT="${CATT:-$(command -v catt || echo "$HOME/.local/bin/catt")}"
TABMEDIA="${TABMEDIA:-$(command -v tab-media || echo "$HOME/.local/bin/tab-media")}"

# TV's IP can drift (DHCP). If a configured IP doesn't answer on the Cast port, rescan and re-pin when exactly one TV is found.
if [ -z "$ATV" ] && [[ "$TV" =~ ^[0-9.]+$ ]] && ! nc -z -G 1 "$TV" 8009 2>/dev/null; then
  FOUND=$("$CATT" scan 2>/dev/null | awk '/ - /{print $1}' | grep -E '^[0-9.]+$')
  if [ "$(echo "$FOUND" | grep -c .)" = 1 ]; then
    echo "TV moved: $TV -> $FOUND (config updated)" >&2
    TV="$FOUND"; set_conf CAST_TV "$TV"   # (not the whole file: CAST_ATV / CAST_USE stay)
  fi
fi
PAGE_PLAYER_SITES='rezka\.|hdrezka|voidboost|voidviral|kinogo|lordfilm'   # yt-dlp can't do these → go straight to the tab
BROWSERS='^(Arc|Google Chrome|Brave Browser|Microsoft Edge|Chromium|Vivaldi)$'

catt() { "$CATT" -d "$TV" "$@" 2>&1 | grep -v "Failed to determine cast type"; return "${PIPESTATUS[0]}"; }

# remote-control commands go through cast-ctl: direct socket to the TV, ~0.2 s (catt looks the TV up over HTTP
# first, ~2.5 s per call). It needs an IP and catt's python (has pychromecast); with a Cast name in CAST_TV → catt.
CTL="$(dirname "$(readlink -f "$0")")/cast-ctl"
CATT_PY=$(head -n1 "$CATT" 2>/dev/null | sed -n 's/^#!//p')
if [ -n "$ATV" ]; then
  # Apple TV: atv-ctl (pyatv's python) keeps a helper process that holds the video's AirPlay connection — the Apple TV
  # stops the video when it closes — and answers the remote commands at once; it does the watching itself
  ATVREMOTE="$(command -v atvremote || echo "$HOME/.local/bin/atvremote")"
  ATV_PY=$(head -n1 "$ATVREMOTE" 2>/dev/null | sed -n 's/^#!//p')
  [ -x "$ATV_PY" ] || { echo "pyatv missing — run install.sh (or: uv tool install pyatv)"; exit 1; }
  ctl() { "$ATV_PY" "$(dirname "$CTL")/atv-ctl" "$ATV" "$@"; }
  watch_tv() { :; }; unwatch_tv() { :; }
elif [[ "$TV" =~ ^[0-9.]+$ ]] && [ -x "$CATT_PY" ] && [ -f "$CTL" ]; then
  ctl() { "$CATT_PY" "$CTL" "$TV" "$@" 2>/dev/null; }
  # after a cast: stay connected, log to ~/Library/Logs/cast-tab.log, reload the video if the TV's player fails
  watch_tv()   { unwatch_tv; nohup "$CATT_PY" "$CTL" "$TV" watch </dev/null >/dev/null 2>&1 & }
  unwatch_tv() { pkill -f "cast-ctl $TV watch" 2>/dev/null; }
else
  watch_tv() { :; }; unwatch_tv() { :; }
  ctl() { case "$1" in
    toggle) catt play_toggle ;;
    time)   "$CATT" -d "$TV" status 2>/dev/null | awk '/^Time:/{split($2,t,":"); print t[1]*3600+t[2]*60+t[3]}' ;;
    *)      catt "$@" ;;
  esac; }
fi

tv_time() { ctl time; }

wait_for_tv() {   # the TV's Cast service goes away for a minute or two after a session ends
  [ -n "$ATV" ] && { nc -z -G 2 "$ATV" 7000 2>/dev/null && return 0; echo "Apple TV not reachable at $ATV (is it on the network?)"; return 1; }
  local i; for i in $(seq 1 30); do
    nc -z -w 2 "$TV" 8009 >/dev/null 2>&1 && return 0
    [ "$i" -eq 1 ] && echo "TV Cast service restarting — waiting…"
    sleep 3
  done; echo "TV not reachable on port 8009 (is it on?)"; return 1
}

case "$1" in
  stop)                   unwatch_tv; ctl stop; exit ;;
  pause|play|toggle|status|skip|volumemute) ctl "$1"; exit ;;
  info)                   [ -n "$ATV" ] && { ctl status; exit; }; catt info; exit ;;
  pair)                   [ -z "$ATV" ] && { echo "Pairing is for an Apple TV: set CAST_ATV=<ip> in $CONFIG"; exit 1; }
                          ctl pair; exit ;;
  rewind|ffwd|seek)       ctl "$1" "${2:-10}"; exit ;;       # seconds (default 10)
  volume)                 ctl volume "${2:-50}"; exit ;;     # 0-100
  volumeup|volumedown)    ctl "$1" "${2:-10}"; exit ;;       # step (default 10)
  back)
    T=$(tv_time); [[ "$T" =~ ^[0-9]+$ ]] || { echo "Nothing playing on TV"; exit 1; }
    unwatch_tv; ctl stop >/dev/null
    R=$("$TABMEDIA" seek "$T"); [ "$R" = ok ] && echo "Back on Mac at $((T/60))m$((T%60))s" || echo "TV stopped (no video in the front tab to resume)"
    exit 0 ;;
  clip) set -- "$(pbpaste | head -n1 | tr -d '[:space:]')"; echo "$1" | grep -qE '^https?://' || { echo "Clipboard has no URL"; exit 1; } ;;
esac

APP=$(osascript -e 'tell application "System Events" to get name of first process whose frontmost is true')
echo "$APP" | grep -qE "$BROWSERS" || APP=Arc     # terminal/Raycast in front → assume Arc

FROM_TAB=0
if [ -n "$1" ]; then PAGE="$1"
else
  PAGE=$(osascript -e "tell application \"$APP\" to get URL of active tab of front window"); FROM_TAB=1
fi
[ -z "$PAGE" ] && { echo "No browser tab URL found"; exit 1; }
HOST=$(echo "$PAGE" | awk -F/ '{print $3}')
echo "Casting${ATV:+ (AirPlay)}: $PAGE"

wait_for_tv || exit 1

# where the page is right now (only when casting the front tab)
SEEK=(); TITLE=()
if [ "$FROM_TAB" -eq 1 ]; then
  INFO=$("$TABMEDIA" info "$APP")
  T=$(echo "$INFO" | sed -n 's/^time=//p'); TT=$(echo "$INFO" | sed -n 's/^title=//p')
  [ -n "$T" ] && [ "$T" -gt 5 ] && SEEK=(-t "$T")
fi
[ -n "$ATV" ] && [ ${#SEEK[@]} -gt 0 ] && SEEK=(-s "${SEEK[1]}")   # atv-ctl's option for the start position

# Apple TV: yt-dlp only finds the stream (HLS master playlist preferred: the Apple TV picks the quality), then it's
# loaded like a page stream. A stream URL given directly is loaded as is.
atv_cast() {
  local R
  if echo "$1" | grep -qiE '\.(m3u8|mp4)(\?|$)'; then R="$1"
  else
    R=$("$CATT_PY" -m yt_dlp -q --no-warnings --no-playlist -f 'bv*[protocol^=m3u8]/b[ext=mp4]/b' \
        -O '%(manifest_url,url)s' -O '%(title)s' "$1" 2>&1) || { echo "$R" | tail -n 1; return 1; }
    [ ${#TITLE[@]} -eq 0 ] && TITLE=(-l "$(echo "$R" | sed -n 2p)")
  fi
  ctl load "$(echo "$R" | head -n1)" "${SEEK[@]}" "${TITLE[@]}"
}

# 1) yt-dlp sites
if ! echo "$HOST" | grep -qiE "$PAGE_PLAYER_SITES"; then
  if [ -n "$ATV" ]; then OUT=$(atv_cast "$PAGE"); RC=$?; echo "$OUT" | tail -n 2
  else OUT=$(catt cast "${SEEK[@]}" "$PAGE"); RC=$?; echo "$OUT" | tail -n 2   # (piping into tail hid catt's exit code)
  fi
  if [ "$RC" -eq 0 ]; then
    [ "$FROM_TAB" -eq 1 ] && "$TABMEDIA" pause "$APP" >/dev/null
    watch_tv; exit 0
  fi
  [ "$FROM_TAB" -eq 0 ] && exit 1
  echo "Not a yt-dlp site — reading the stream from the $APP tab…"
fi

# 2) stream straight from the page's player
[ "$FROM_TAB" -eq 0 ] && { echo "This site must be open in the browser: open it, then run cast-tab without a URL."; exit 1; }
FILES='\.(mp4|webm|mpd)(\?|$)'; [ -n "$ATV" ] && FILES='\.mp4(\?|$)'   # Apple TV plays no DASH (.mpd) or WebM
pick() { STREAM=$(echo "$MEDIA" | grep -iE 'manifest\.m3u8|\.m3u8(\?|$)' | head -n1)
         [ -z "$STREAM" ] && STREAM=$(echo "$MEDIA" | grep -iE "$FILES" | head -n1)
         SUBS=$(echo "$MEDIA" | grep -iE '\.(vtt|srt)(\?|$)' | head -n1); }
MEDIA=$("$TABMEDIA" urls "$APP"); pick
if [ -z "$STREAM" ]; then
  echo "No stream loaded yet — starting the page video…"
  "$TABMEDIA" play "$APP" >/dev/null
  for i in 1 2 3 4 5 6 7 8; do sleep 1; MEDIA=$("$TABMEDIA" urls "$APP"); pick; [ -n "$STREAM" ] && break; done
  [ -z "$STREAM" ] && { echo "No stream found in the tab (DRM or player in an iframe?). Press play in the page and retry."; exit 1; }
  INFO=$("$TABMEDIA" info "$APP"); TT=$(echo "$INFO" | sed -n 's/^title=//p'); SEEK=()
fi
[ -n "$TT" ] && TITLE=(-l "$TT")

"$TABMEDIA" pause "$APP" >/dev/null
echo "Stream: ${STREAM:0:90}…"; [ -n "$SUBS" ] && echo "Subtitles: ${SUBS:0:90}…"
if [ -n "$ATV" ]; then
  OUT=$(ctl load "$STREAM" "${SEEK[@]}" "${TITLE[@]}" ${SUBS:+-c "$SUBS"}); RC=$?; echo "$OUT" | tail -n 1
  exit "$RC"
fi
# catt fetches the stream once itself before it tells the TV; the stream's server sometimes leaves that request
# hanging and catt gives up (nothing has reached the TV yet) → try again
for TRY in 1 2 3; do
  OUT=$(catt cast ${SUBS:+-s "$SUBS"} "${TITLE[@]}" "${SEEK[@]}" "$STREAM"); RC=$?
  [ "$RC" -eq 0 ] && break
  echo "$OUT" | grep -qE "Remote resource not found|yt-dlp extractor failed" || break
  [ "$TRY" -lt 3 ] && echo "Stream server did not answer — trying again ($((TRY + 1))/3)…"
done
echo "$OUT" | tail -n 1
if [ "$RC" -eq 0 ]; then watch_tv
else echo "$OUT" | grep -qE "Remote resource not found|yt-dlp extractor failed" && echo "Stream server is not answering (tried 3 times) — press play in the page, or cast again in a minute"
fi
